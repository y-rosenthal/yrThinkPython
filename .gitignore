*.py[co]

# Packages
*.egg
*.egg-info
dist
build
eggs
parts
bin
var
sdist
develop-eggs
.installed.cfg

# Installer logs
pip-log.txt

# Unit test / coverage reports
.coverage
.tox

#Translations
*.mo

#Mr Developer
.mr.developer.cfg

# Jupyter Book build artifacts (notebooks are copied into jb/ at build time)
jb/_build/
jb/chap*.ipynb
jb/yr/

# Quarto build output of the author guide (render with: cd author-guide && quarto render)
author-guide/_book/
author-guide/.quarto/
# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
__pycache__/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# ThinkPythonSolutions is a separate git repo that manages its own files.
# Clone it alongside this one; the build scripts read from it.
# ---------------------------------------------------------------------------
ThinkPythonSolutions/

# ---------------------------------------------------------------------------
# Generated by jb/build.sh -- chapter copies pulled from soln/, plus the
# Jupyter Book output that ghp-import publishes.
# Note: jb/index.md, jb/blank.md, jb/_config.yml and jb/_toc.yml are SOURCE
# and belong in version control.
# ---------------------------------------------------------------------------
jb/_build/
jb/chap*.ipynb

# ---------------------------------------------------------------------------
# Support files copied from ThinkPythonSolutions/soln/ by the build scripts.
# The canonical copies are the ones tracked at the top level of this repo.
# ---------------------------------------------------------------------------
chapters/thinkpython.py
chapters/diagram.py
chapters/structshape.py
chapters/jupyturtle.py
chapters/photos.zip
chapters/photos/
blank/thinkpython.py
blank/diagram.py
blank/structshape.py
blank/jupyturtle.py
blank/photos.zip
blank/photos/

# ---------------------------------------------------------------------------
# Text files the notebooks download or write when they run
# (words.txt, pg43.txt, dr_jekyll.txt, camel-spotting-book.txt, ...).
# The tracked words.txt at the top level is the canonical copy.
# ---------------------------------------------------------------------------
chapters/*.txt
blank/*.txt

# begin yrProject v0.7.4: written by yrProject.sh (https://github.com/y-rosenthal/yrProject); "yrProject.sh update" replaces this block; do not edit it
# yrIssues: the saved copy of the open issues and the offline queue are written by the skill, not committed
_yrIssues/issues.md
_yrIssues/queue.md
# end yrProject
