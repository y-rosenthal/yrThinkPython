{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.yrProject/session-start.json\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/yrIssues/scripts/yrIssues.sh\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/yrIssues/scripts/yrIssues.sh\" hook-sync",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
